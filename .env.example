DB_NAME=
DB_USER=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Host port for MySQL (default 3307; 3306 is often taken)
MYSQL_HOST_PORT=3307
# Backend connection (defaults: localhost, 3307; inside Compose use mysql, 3306)
# DB_HOST=localhost
# DB_PORT=3307
# JWT signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Optional token lifetime in minutes (default 60)
# JWT_EXPIRATION_MINUTES=60
